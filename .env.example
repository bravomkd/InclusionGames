# ─────────────────────────────────────────────────────────────
# InclusionGames — environment configuration
# Copy this file to ".env" and fill in real values.
# The server runs WITHOUT any of these set (demo mode), so you can
# test the whole auth flow locally before adding payment keys.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
# Public base URL of the site (used in verification / reset / checkout return links)
APP_URL=http://localhost:3000

# Secret used to sign JSON Web Tokens.
# REQUIRED in production: the server refuses to start with this placeholder or
# with anything shorter than 32 characters, because a guessable key lets anyone
# forge a session for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the account database lives. Defaults to ./data next to server.js.
# Point this outside the web root in production so the database cannot be
# reached over HTTP at all.
# DATA_DIR=/var/lib/inclusion

# ── Email (nodemailer SMTP) ──────────────────────────────────
# If these are blank, the server prints verification/reset links to the
# console instead of emailing them (handy for local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InclusionGames <hello@inclusion-games.com>"

# ── Stripe (credit / debit card) ─────────────────────────────
# Leave blank to disable Stripe. Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard, one per plan (monthly).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_EDUCATOR=
STRIPE_PRICE_SCHOOL=

# ── PayPal ───────────────────────────────────────────────────
# Leave blank to disable PayPal. Get credentials at https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" while testing, "live" for production
PAYPAL_ENV=sandbox

# ── CopeCart (added later) ───────────────────────────────────
# Shared secret used to validate the CopeCart IPN webhook signature.
# The webhook grants paid access, so with this unset the endpoint refuses every
# request rather than trusting an unsigned one.
COPECART_WEBHOOK_SECRET=
